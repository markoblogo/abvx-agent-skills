+import unittest
+
+from app import unique
+
+
+class UniqueTest(unittest.TestCase):
+    def test_preserves_first_seen_order(self):
+        first = ("first",)
+        values = [3, 1, 3, first, None, "a", 1, ("first",), None]
+        result = unique(iter(values))
+        self.assertEqual(result, [3, 1, first, None, "a"])
+        self.assertIs(result[2], first)
+        self.assertEqual(unique([]), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
