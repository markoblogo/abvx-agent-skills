+class ApplyOverridesTests(unittest.TestCase):
+    def test_returns_fresh_mapping(self):
+        defaults = {'timeout': 10, 'retries': 2}
+        result = apply_overrides(defaults, {'timeout': 20})
+        self.assertEqual(result, {'timeout': 20, 'retries': 2})
+        self.assertIsNot(result, defaults)
+        self.assertEqual(defaults, {'timeout': 10, 'retries': 2})
+
+    def test_empty_overrides_return_fresh_mapping(self):
+        for defaults in ({}, {'timeout': 10}):
+            with self.subTest(defaults=defaults):
+                result = apply_overrides(defaults, {})
+                self.assertEqual(result, defaults)
+                self.assertIsNot(result, defaults)
+
+    def test_unknown_key_raises_without_changing_defaults(self):
+        defaults = {'timeout': 10}
+        with self.assertRaises(KeyError) as caught:
+            apply_overrides(defaults, {'timeout': 20, 'unknown': 1})
+        self.assertEqual(caught.exception.args, ('unknown',))
+        self.assertEqual(defaults, {'timeout': 10})
+
+
+if __name__ == '__main__':
+    unittest.main()
